# Copy this file to .env.local and fill in both values from
# Supabase dashboard > Project Settings > API (or "Connect").
# Both are safe in the browser: row-level security protects the data.
# NEVER put the secret / service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
